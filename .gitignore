# Python 运行产物
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# 实验输出（只能写入 --output 指定目录，不入库）
outputs/
runs/
wandb/

# 模型权重与大文件
*.ckpt
*.pt
*.pth
*.log

# 环境与密钥
.env
.env.*

# 大型或不可再分发数据不入库（经 manifest + 下载/生成脚本 + SHA256 治理）
# 允许进入 Git 的小型 fixture 必须放在 tests/fixtures/，不得用宽泛的 data/ 例外绕过治理

# 本地工件槽位（锚定仓库根，不影响 release/ 等源码目录）：
# data/、results/、checkpoints/ 只存放线下装配工件；槽位描述文件
# （README + manifest/指标摘要，共 7 个）白名单入库（与相控阵组件同法）。
# 槽位映射真值 = handoff/artifact-map.yaml；装配步骤见 handoff/HANDOFF.md
/data/**
!/data/README.md
!/data/data_manifest.json
/results/**
!/results/README.md
!/results/public_summary.json
!/results/expected_metrics.json
/checkpoints/**
!/checkpoints/README.md
!/checkpoints/checkpoint_manifest.json

# release/ 下的工件槽位（装配时才落盘，防御性排除）
/release/data/
/release/checkpoints/
/release/results/

# 原交付 RELEASE_MANIFEST.sha256（470 条，含线下工件条目）：
# 线下参考输入，不作为 Git 代码校验真值（真值 = release/CODE_MANIFEST.sha256）
/release/RELEASE_MANIFEST.sha256

# 本地私有内容（PR body 等，绝不入库）
.private/
